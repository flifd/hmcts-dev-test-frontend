{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{% block content %}

{{ govukBackLink({
  text: "Back",
  href: "/"
}) }}

{# Task details #}
{% set rows = [] %}

    {% if task.description %}
        {% set rows = rows.concat([
            [
                {
                    text: "Description"
                }, {
                    text: task.description
                }
            ]
        ]) %}
    {% endif %}

{% set rows = rows.concat([
  [
    {
      text: "Status"
    }, {
      text: task.status
    }
  ],
  [
    {
      text: "Due by"
    }, {
      text: task.dueTimestamp
    }
  ],
  [
    {
      text: "Created on"
    }, {
      text: task.createdTimestamp
    }
  ],
  [
    {
      text: "Last updated"
    }, {
      text: task.updatedTimestamp
    }
  ]
]) %}

{{ govukTable({
  caption: task.title,
  captionClasses: "govuk-table__caption--m",
  firstCellIsHeader: false,
  rows: rows
}) }}

{# Status buttons #}
{% macro deleteButton(taskId) %}
  <form action="/tasks/{{ taskId }}/delete" method="POST" style="text-align: center;">
    <input type="hidden" name="_method" value="DELETE">
    {{ govukButton({
      text: "Delete task",
      type: "submit",
      classes: "govuk-button--warning"
    }) }}
  </form>
{% endmacro %}

{% if task.status === "PENDING" %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <p></p>
    </div>
    <div class="govuk-grid-column-one-third">{{ deleteButton(task.id) }}</div>
    <div class="govuk-grid-column-one-third">
      <form action="/tasks/{{ task.id }}/status" method="POST" style="text-align: right;">
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="taskStatus" value="IN_PROGRESS">
        {{ govukButton({
          text: "Mark as in progress",
          type: "submit"
        }) }}
      </form>
    </div>
  </div>

{% elif task.status === "IN_PROGRESS" %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <form action="/tasks/{{ task.id }}/status" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="taskStatus" value="PENDING">
        {{ govukButton({
          text: "Mark as pending",
          type: "submit"
        }) }}
      </form>
    </div>
    <div class="govuk-grid-column-one-third">{{ deleteButton(task.id) }}</div>
    <div class="govuk-grid-column-one-third">
      <form action="/tasks/{{ task.id }}/status" method="POST" style="text-align: right;">
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="taskStatus" value="COMPLETED">
        {{ govukButton({
          text: "Mark as complete",
          type: "submit"
        }) }}
      </form>
    </div>
  </div>

{% elif task.status === "COMPLETED" %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <form action="/tasks/{{ task.id }}/status" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="taskStatus" value="IN_PROGRESS">
        {{ govukButton({
          text: "Mark as in progress",
          type: "submit"
        }) }}
      </form>
    </div>
    <div class="govuk-grid-column-one-third">{{ deleteButton(task.id) }}</div>
    <div class="govuk-grid-column-one-third">
      <p></p>
    </div>
  </div>
{% endif %}

{% endblock %}